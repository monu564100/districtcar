rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Email OTPs for Customer & Driver verification
    match /email_otps/{email} {
      allow read, write: if true;
    }

    match /driver_otps/{email} {
      allow read, write: if true;
    }

    // Vehicle categories catalog (Pricing & types)
    match /vehicleCategories/{categoryId} {
      allow read, write: if true;
    }

    // Customer User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Driver Partner Profiles
    match /drivers/{driverId} {
      allow read, write: if true;
    }

    // Registered Vehicles
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Bookings & Rides
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Driver dispatch requests
    match /bookingRequests/{requestId} {
      allow read, write: if true;
    }

    // Notifications & Ratings
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    match /supportTickets/{ticketId} {
      allow read, write: if true;
    }

    match /appConfig/{configId} {
      allow read, write: if true;
    }

    match /fareConfigs/{fareId} {
      allow read, write: if true;
    }

    // Global rule for testing & development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

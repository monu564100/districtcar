# District Car Notification Service Configuration

PORT=4000

# Firebase Project Credentials
FIREBASE_PROJECT_ID=districtcar-4b880
# Path to service account json key file (optional if using GOOGLE_APPLICATION_CREDENTIALS or FCM Legacy Server Key fallback)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Optional: Firebase Cloud Messaging Legacy Server Key (loaded dynamically from Firestore app_config/fcm_settings as well)
FCM_SERVER_KEY=

# Automation Cron Settings
# Upcoming Booking Reminder check interval (default every 5 minutes: */5 * * * *)
CRON_UPCOMING_BOOKING="*/5 * * * *"

# Travel Engagement Campaign check interval (e.g., 10:00 AM and 04:30 PM daily: "0 10,16 * * *", or every 2 hours: "0 */2 * * *")
CRON_TRAVEL_CAMPAIGN="0 10,17 * * *"

# Enable or disable automated cron tasks (true/false)
ENABLE_AUTOMATED_REMINDERS=true
ENABLE_TRAVEL_CAMPAIGNS=true

# District Car — Production Environment Variables

# Environment Name: development | staging | production
DISTRICT_ENV=development

# Google Maps API Key (Configured for Maps SDK, Places API, Directions API)
GOOGLE_MAPS_API_KEY=AIzaSyDummyKeyReplaceWithYourGoogleMapsKey

# Primary Cloud Functions Region
FIREBASE_FUNCTIONS_REGION=asia-south1

# Firebase Project ID
FIREBASE_PROJECT_ID=district-car-prod

# Currency
APP_CURRENCY_SYMBOL=₹
APP_CURRENCY_CODE=INR

# Matching parameters
INITIAL_SEARCH_RADIUS_KM=5
MAX_SEARCH_RADIUS_KM=15
DRIVER_REQUEST_TIMEOUT_SECONDS=25
